{
  "schemaVersion": 1,
  "id": "fan.summer.excel",
  "name": "Excel Splitter",
  "description": "Split Excel workbooks by sheet, column value, or complex rules",
  "version": "4.0.0-alpha.6",
  "author": "FengYu",
  "icon": "file-excel",
  "category": "file",
  "ui": { "entry": "ui/index.html" },
  "backend": { "command": "java -jar backend/worker.jar", "protocol": "json-rpc-2.0" },
  "permissions": ["files.read", "files.write"],
  "homepage": "https://github.com/MuskStark/FengYu",
  "official": true,
  "aiTools": [
    {"name":"excel_analyze","effect":"read","description":"Analyze the granted Excel workbook before configuring or executing any split; returns sheet names.","method":"excel_analyze","timeoutSeconds":30,"inputSchema":"{\"type\":\"object\",\"properties\":{\"filePath\":{\"type\":\"object\",\"title\":\"Excel file\",\"description\":\"A readable FengYu FileRef for the Excel workbook\"}},\"required\":[\"filePath\"]}","outputSchema":"{\"type\":\"object\",\"properties\":{\"success\":{\"type\":\"boolean\"},\"summary\":{\"type\":\"string\"},\"sheets\":{\"type\":\"array\",\"description\":\"Workbook sheet names\",\"items\":{\"type\":\"string\"}}},\"required\":[\"success\",\"summary\"]}"},
    {"name":"excel_configure","effect":"read","description":"Configure sheet, column, or complex splitting.","method":"excel_configure","timeoutSeconds":30,"inputSchema":"{\"type\":\"object\",\"properties\":{\"mode\":{\"type\":\"string\",\"title\":\"Split mode\",\"enum\":[\"BY_SHEET\",\"BY_COLUMN\",\"COMPLEX\"]},\"sheets\":{\"type\":\"array\",\"title\":\"Sheets\",\"description\":\"Leave empty to use all sheets\",\"items\":{\"type\":\"string\"}},\"splitSheet\":{\"type\":\"string\",\"title\":\"Source sheet\"},\"splitColumn\":{\"type\":\"string\",\"title\":\"Split column\"}},\"required\":[\"mode\"]}","outputSchema":"{\"type\":\"object\",\"properties\":{\"success\":{\"type\":\"boolean\"},\"summary\":{\"type\":\"string\"}},\"required\":[\"success\",\"summary\"]}"},
    {"name":"excel_complex_config","effect":"read","description":"Add, list, or clear complex split rules.","method":"excel_complex_config","timeoutSeconds":30,"inputSchema":"{\"type\":\"object\",\"properties\":{\"action\":{\"type\":\"string\",\"title\":\"Action\",\"enum\":[\"add\",\"list\",\"clear\"]},\"sheetName\":{\"type\":\"string\",\"title\":\"Sheet name\"},\"headerIndex\":{\"type\":\"integer\",\"title\":\"Header row index\"},\"columnIndex\":{\"type\":\"integer\",\"title\":\"Column index\"}},\"required\":[\"action\"]}","outputSchema":"{\"type\":\"object\",\"properties\":{\"success\":{\"type\":\"boolean\"},\"summary\":{\"type\":\"string\"},\"entries\":{\"type\":\"array\",\"description\":\"Configured complex split rules\",\"items\":{\"type\":\"object\"}}},\"required\":[\"success\",\"summary\"]}"},
    {"name":"excel_execute","effect":"write","description":"Execute a configured split synchronously for a small workbook.","method":"excel_execute","timeoutSeconds":60,"inputSchema":"{\"type\":\"object\",\"properties\":{\"outputDir\":{\"type\":\"object\",\"title\":\"Output directory\",\"description\":\"A writable FengYu DirectoryRef selected for split results\"},\"filePrefix\":{\"type\":\"string\",\"title\":\"File prefix\"}},\"required\":[\"outputDir\"]}","outputSchema":"{\"type\":\"object\",\"properties\":{\"success\":{\"type\":\"boolean\"},\"summary\":{\"type\":\"string\"},\"files\":{\"type\":\"object\",\"description\":\"Generated file count and names\"}},\"required\":[\"success\",\"summary\"]}"},
    {"name":"excel_execute_start","effect":"write","description":"Start a configured split job and return its job ID.","method":"excel_execute_start","timeoutSeconds":30,"inputSchema":"{\"type\":\"object\",\"properties\":{\"outputDir\":{\"type\":\"object\",\"title\":\"Output directory\",\"description\":\"A writable FengYu DirectoryRef selected for split results\"},\"filePrefix\":{\"type\":\"string\",\"title\":\"File prefix\"}},\"required\":[\"outputDir\"]}","outputSchema":"{\"type\":\"object\",\"properties\":{\"success\":{\"type\":\"boolean\"},\"summary\":{\"type\":\"string\"},\"jobId\":{\"type\":\"string\",\"description\":\"Job identifier for status polling\"}},\"required\":[\"success\",\"summary\"]}"},
    {"name":"excel_execute_status","effect":"read","description":"Poll an Excel split job and return logs and its final result.","method":"excel_execute_status","timeoutSeconds":30,"inputSchema":"{\"type\":\"object\",\"properties\":{\"jobId\":{\"type\":\"string\",\"title\":\"Job ID\"},\"cursor\":{\"type\":\"integer\",\"title\":\"Log cursor\",\"default\":0,\"minimum\":0}},\"required\":[\"jobId\"]}","outputSchema":"{\"type\":\"object\",\"properties\":{\"success\":{\"type\":\"boolean\"},\"summary\":{\"type\":\"string\"},\"jobId\":{\"type\":\"string\"},\"status\":{\"type\":\"string\"},\"logs\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"cursor\":{\"type\":\"integer\"},\"done\":{\"type\":\"boolean\"},\"result\":{\"type\":\"object\"},\"error\":{\"type\":\"string\"}},\"required\":[\"success\",\"summary\"]}"},
    {"name":"excel_query","effect":"read","description":"Return the current Excel split session state.","method":"excel_query","timeoutSeconds":30,"inputSchema":"{\"type\":\"object\",\"properties\":{}}","outputSchema":"{\"type\":\"object\",\"properties\":{\"success\":{\"type\":\"boolean\"},\"summary\":{\"type\":\"string\"},\"state\":{\"type\":\"object\",\"description\":\"Current Excel split session state\"}},\"required\":[\"success\",\"summary\"]}"},
    {"name":"excel_cancel","effect":"read","description":"Clear the active Excel split session.","method":"excel_cancel","timeoutSeconds":30,"inputSchema":"{\"type\":\"object\",\"properties\":{}}","outputSchema":"{\"type\":\"object\",\"properties\":{\"success\":{\"type\":\"boolean\"},\"summary\":{\"type\":\"string\"}},\"required\":[\"success\",\"summary\"]}"}
  ]
}
