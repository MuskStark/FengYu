{
  "schemaVersion": 2,
  "id": "fan.summer.offlinepython",
  "name": "Offline Python Builder",
  "description": "Build offline Python install repositories with all dependencies",
  "version": "4.0.0-beta.4",
  "author": "FengYu",
  "icon": "language-python",
  "category": "dev",
  "ui": { "entry": "ui/index.html" },
  "backend": { "callTimeoutSeconds": 60 },
  "permissions": ["files.read", "files.write", "network"],
  "homepage": "https://github.com/MuskStark/FengYu",
  "official": true,
  "rpc": {
    "methods": {
      "init": {
        "description": "Initialize an offline-Python project skeleton (config.json, requirements.txt, README.md) in a writable directory.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "projectDir": { "type": "string", "description": "Absolute path of the writable project directory (host resolves the FileRef to a path)." },
            "session": { "type": "string", "nullable": true, "description": "Optional UI session key; absent for AI tools." }
          },
          "required": ["projectDir"]
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "success": { "type": "boolean", "description": "true when the project skeleton was initialized." },
            "summary": { "type": "string", "description": "Short localized result summary." },
            "projectDir": { "type": "string", "nullable": true, "description": "The initialized project directory." }
          },
          "required": ["success", "summary"]
        }
      },
      "configGet": {
        "description": "Load the project's BuildConfig (merged from config.json or defaults).",
        "inputSchema": {
          "type": "object",
          "properties": {
            "projectDir": { "type": "string", "nullable": true, "description": "Project directory to bind the session to." },
            "session": { "type": "string", "nullable": true, "description": "UI session key; defaults to the shared AI session when absent." }
          }
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "success": { "type": "boolean" },
            "summary": { "type": "string" },
            "config": {
              "type": "object",
              "description": "The full worker BuildConfig (depPlatforms is preserved on disk by config.save and is not surfaced here).",
              "properties": {
                "python": {
                  "type": "object",
                  "properties": {
                    "version": { "type": "string" },
                    "platforms": { "type": "array", "items": { "type": "string" } },
                    "implementation": { "type": "string" },
                    "installer": { "type": "boolean" },
                    "executable": { "type": "string", "nullable": true, "description": "Python executable path; null = auto-detect." }
                  }
                },
                "repository": {
                  "type": "object",
                  "properties": {
                    "output": { "type": "string" },
                    "wheelDir": { "type": "string" },
                    "cache": { "type": "boolean" }
                  }
                },
                "download": {
                  "type": "object",
                  "properties": {
                    "mirror": { "type": "string" },
                    "upgradePip": { "type": "boolean" },
                    "recursive": { "type": "boolean" },
                    "onlyBinary": { "type": "boolean" }
                  }
                },
                "pkg": {
                  "type": "object",
                  "properties": {
                    "zip": { "type": "boolean" },
                    "sha256": { "type": "boolean" },
                    "readme": { "type": "boolean" }
                  }
                },
                "bundle": {
                  "type": "object",
                  "properties": {
                    "autoPackage": { "type": "boolean" },
                    "name": { "type": "string" },
                    "sha256": { "type": "boolean" }
                  }
                }
              }
            }
          },
          "required": ["success", "summary"]
        }
      },
      "configSave": {
        "description": "Persist requirements.txt and merge the supplied config sections onto config.json.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "projectDir": { "type": "string", "description": "Project directory to save into." },
            "session": { "type": "string", "nullable": true },
            "config": {
              "type": "object",
              "description": "Full or partial BuildConfig; merged onto the on-disk config so omitted sections keep their values.",
              "properties": {
                "python": {
                  "type": "object",
                  "properties": {
                    "version": { "type": "string" },
                    "platforms": { "type": "array", "items": { "type": "string" } },
                    "implementation": { "type": "string" },
                    "installer": { "type": "boolean" },
                    "executable": { "type": "string", "nullable": true }
                  }
                },
                "repository": {
                  "type": "object",
                  "properties": {
                    "output": { "type": "string" },
                    "wheelDir": { "type": "string" },
                    "cache": { "type": "boolean" }
                  }
                },
                "download": {
                  "type": "object",
                  "properties": {
                    "mirror": { "type": "string" },
                    "upgradePip": { "type": "boolean" },
                    "recursive": { "type": "boolean" },
                    "onlyBinary": { "type": "boolean" }
                  }
                },
                "pkg": {
                  "type": "object",
                  "properties": {
                    "zip": { "type": "boolean" },
                    "sha256": { "type": "boolean" },
                    "readme": { "type": "boolean" }
                  }
                },
                "bundle": {
                  "type": "object",
                  "properties": {
                    "autoPackage": { "type": "boolean" },
                    "name": { "type": "string" },
                    "sha256": { "type": "boolean" }
                  }
                }
              }
            }
          },
          "required": ["projectDir"]
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "success": { "type": "boolean" },
            "summary": { "type": "string" }
          },
          "required": ["success", "summary"]
        }
      },
      "requirementsGet": {
        "description": "Read requirements.txt from a project directory (empty string when absent).",
        "inputSchema": {
          "type": "object",
          "properties": {
            "projectDir": { "type": "string", "description": "Project directory." }
          },
          "required": ["projectDir"]
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "success": { "type": "boolean" },
            "summary": { "type": "string" },
            "text": { "type": "string", "nullable": true, "description": "The requirements.txt contents." }
          },
          "required": ["success", "summary"]
        }
      },
      "requirementsSave": {
        "description": "Write requirements.txt into a project directory.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "projectDir": { "type": "string" },
            "text": { "type": "string", "nullable": true, "description": "The requirements.txt contents; null/empty clears the file." }
          },
          "required": ["projectDir"]
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "success": { "type": "boolean" },
            "summary": { "type": "string" }
          },
          "required": ["success", "summary"]
        }
      },
      "pythonDetect": {
        "description": "Detect the host Python/pip interpreter, optionally from a configured executable path.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "executable": { "type": "string", "nullable": true, "description": "Python executable path; null/empty = auto-detect on PATH." }
          }
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "success": { "type": "boolean" },
            "summary": { "type": "string" },
            "detection": {
              "type": "object",
              "properties": {
                "executable": { "type": "string", "nullable": true },
                "pythonVersion": { "type": "string", "nullable": true },
                "pipVersion": { "type": "string", "nullable": true },
                "ok": { "type": "boolean" }
              }
            }
          },
          "required": ["success", "summary"]
        }
      },
      "depsLatest": {
        "description": "Resolve the latest available version of a package via pip index versions.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "pkg": { "type": "string", "description": "Package name." },
            "executable": { "type": "string", "nullable": true, "description": "Python executable; null = auto-detect." }
          },
          "required": ["pkg"]
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "success": { "type": "boolean" },
            "summary": { "type": "string" },
            "version": { "type": "string", "nullable": true, "description": "Latest version, or null when none found." }
          },
          "required": ["success", "summary"]
        }
      },
      "depsSearch": {
        "description": "Search PyPI for available wheels for a package (version, platform, size, filename).",
        "inputSchema": {
          "type": "object",
          "properties": {
            "pkg": { "type": "string", "description": "Package name." }
          },
          "required": ["pkg"]
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "success": { "type": "boolean" },
            "summary": { "type": "string" },
            "wheels": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "version": { "type": "string" },
                  "platformTag": { "type": "string" },
                  "sizeBytes": { "type": "integer" },
                  "filename": { "type": "string" }
                }
              }
            }
          },
          "required": ["success", "summary"]
        }
      },
      "verify": {
        "description": "Verify an offline-build output/ repository against its manifest (SHA256, integrity, wheels, requirements).",
        "inputSchema": {
          "type": "object",
          "properties": {
            "projectDir": { "type": "string" },
            "session": { "type": "string", "nullable": true },
            "scope": { "type": "string", "enum": ["ALL", "INTEGRITY", "SHA256"], "nullable": true, "description": "Verification scope; defaults to ALL." }
          },
          "required": ["projectDir"]
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "success": { "type": "boolean" },
            "summary": { "type": "string" },
            "result": {
              "type": "object",
              "description": "Per-check outcomes; individual checks are null when out of scope.",
              "properties": {
                "sha256": { "type": "object", "nullable": true, "properties": {
                  "status": { "type": "string", "enum": ["PASS", "WARN", "FAIL"] },
                  "detail": { "type": "string", "nullable": true },
                  "problems": { "type": "array", "items": { "type": "string" } }
                }, "required": ["status"] },
                "fileIntegrity": { "type": "object", "nullable": true, "properties": {
                  "status": { "type": "string", "enum": ["PASS", "WARN", "FAIL"] },
                  "detail": { "type": "string", "nullable": true },
                  "problems": { "type": "array", "items": { "type": "string" } }
                }, "required": ["status"] },
                "wheels": { "type": "object", "nullable": true, "properties": {
                  "status": { "type": "string", "enum": ["PASS", "WARN", "FAIL"] },
                  "detail": { "type": "string", "nullable": true },
                  "problems": { "type": "array", "items": { "type": "string" } }
                }, "required": ["status"] },
                "requirements": { "type": "object", "nullable": true, "properties": {
                  "status": { "type": "string", "enum": ["PASS", "WARN", "FAIL"] },
                  "detail": { "type": "string", "nullable": true },
                  "problems": { "type": "array", "items": { "type": "string" } }
                }, "required": ["status"] },
                "manifest": { "type": "object", "nullable": true, "properties": {
                  "status": { "type": "string", "enum": ["PASS", "WARN", "FAIL"] },
                  "detail": { "type": "string", "nullable": true },
                  "problems": { "type": "array", "items": { "type": "string" } }
                }, "required": ["status"] }
              }
            }
          },
          "required": ["success", "summary"]
        }
      },
      "package": {
        "description": "Package a built output/ repository into a deployable bundle ZIP.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "projectDir": { "type": "string" },
            "session": { "type": "string", "nullable": true }
          },
          "required": ["projectDir"]
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "success": { "type": "boolean" },
            "summary": { "type": "string" },
            "zipPath": { "type": "string", "nullable": true, "description": "The produced bundle ZIP path." }
          },
          "required": ["success", "summary"]
        }
      },
      "doctor": {
        "description": "Diagnose the host Python and pip environment for offline-build readiness.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "executable": { "type": "string", "nullable": true, "description": "Python executable; null = auto-detect." }
          }
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "success": { "type": "boolean" },
            "summary": { "type": "string" },
            "checks": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": { "type": "string" },
                  "value": { "type": "string", "nullable": true },
                  "ok": { "type": "boolean" }
                }
              }
            }
          },
          "required": ["success", "summary"]
        }
      },
      "buildStart": {
        "description": "Start an offline wheelhouse build (pip download) as a background job and return its job id.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "projectDir": { "type": "string" },
            "session": { "type": "string", "nullable": true },
            "executable": { "type": "string", "nullable": true, "description": "Python executable; null = auto-detect." }
          },
          "required": ["projectDir"]
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "success": { "type": "boolean" },
            "summary": { "type": "string" },
            "jobId": { "type": "string", "nullable": true, "description": "Job identifier for status polling." }
          },
          "required": ["success", "summary"]
        }
      },
      "buildStatus": {
        "description": "Poll a build job: streamed logs (from cursor) and the final BuildSummary result when done.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "jobId": { "type": "string" },
            "cursor": { "type": "integer", "minimum": 0, "description": "Absolute log cursor from a prior snapshot; 0 = start." }
          },
          "required": ["jobId"]
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "success": { "type": "boolean" },
            "summary": { "type": "string" },
            "jobId": { "type": "string" },
            "type": { "type": "string", "nullable": true, "description": "Job type label (BUILD)." },
            "status": { "type": "string" },
            "logs": { "type": "array", "items": { "type": "string" } },
            "cursor": { "type": "integer" },
            "droppedLogs": { "type": "integer" },
            "done": { "type": "boolean" },
            "result": { "type": "object", "nullable": true, "description": "BuildSummary totals (present once the build completes).", "properties": {
              "totalWheels": { "type": "integer" },
              "cacheHits": { "type": "integer" },
              "totalBytes": { "type": "integer" },
              "durationMs": { "type": "integer" }
            }},
            "error": { "type": "string", "nullable": true },
            "elapsedMs": { "type": "integer" }
          },
          "required": ["success", "summary"]
        }
      },
      "buildCancel": {
        "description": "Cancel a running build job; terminates the pip subprocess tree.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "jobId": { "type": "string" }
          },
          "required": ["jobId"]
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "success": { "type": "boolean" },
            "summary": { "type": "string" },
            "jobId": { "type": "string", "nullable": true }
          },
          "required": ["success", "summary"]
        }
      },
      "deployStart": {
        "description": "Start an offline deploy (per-wheel pip install) of a bundle ZIP as a background job.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "zipPath": { "type": "string", "description": "Bundle ZIP path." },
            "target": {
              "type": "object",
              "description": "Install target: global site-packages or a new virtualenv.",
              "properties": {
                "kind": { "type": "string", "enum": ["global", "venv"], "nullable": true },
                "pythonExe": { "type": "string", "description": "Target interpreter path." },
                "venvPath": { "type": "string", "nullable": true, "description": "venv target only: directory to create." }
              },
              "required": ["pythonExe"]
            }
          },
          "required": ["zipPath", "target"]
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "success": { "type": "boolean" },
            "summary": { "type": "string" },
            "jobId": { "type": "string", "nullable": true }
          },
          "required": ["success", "summary"]
        }
      },
      "deployStatus": {
        "description": "Poll a deploy job: streamed logs (from cursor) and the final DeployResult when done.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "jobId": { "type": "string" },
            "cursor": { "type": "integer", "minimum": 0 }
          },
          "required": ["jobId"]
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "success": { "type": "boolean" },
            "summary": { "type": "string" },
            "jobId": { "type": "string" },
            "type": { "type": "string", "nullable": true },
            "status": { "type": "string" },
            "logs": { "type": "array", "items": { "type": "string" } },
            "cursor": { "type": "integer" },
            "droppedLogs": { "type": "integer" },
            "done": { "type": "boolean" },
            "result": { "type": "object", "nullable": true, "description": "DeployResult totals (present once the deploy completes).", "properties": {
              "installed": { "type": "integer" },
              "skipped": { "type": "integer" },
              "failed": { "type": "integer" },
              "durationMs": { "type": "integer" }
            }},
            "error": { "type": "string", "nullable": true },
            "elapsedMs": { "type": "integer" }
          },
          "required": ["success", "summary"]
        }
      },
      "deployCancel": {
        "description": "Cancel a running deploy job; terminates the pip subprocess tree.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "jobId": { "type": "string" }
          },
          "required": ["jobId"]
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "success": { "type": "boolean" },
            "summary": { "type": "string" },
            "jobId": { "type": "string", "nullable": true }
          },
          "required": ["success", "summary"]
        }
      },
      "offlinepythonDoctor": {
        "description": "AI tool: diagnose the host Python and pip environment for offline-build readiness.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "executable": { "type": "string", "nullable": true, "description": "Python executable; null = auto-detect." }
          }
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "success": { "type": "boolean" },
            "summary": { "type": "string" },
            "checks": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": { "type": "string" },
                  "value": { "type": "string", "nullable": true },
                  "ok": { "type": "boolean" }
                }
              }
            }
          },
          "required": ["success", "summary"]
        }
      },
      "offlinepythonSearchDeps": {
        "description": "AI tool: search PyPI for available wheels for a package.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "pkg": { "type": "string" }
          },
          "required": ["pkg"]
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "success": { "type": "boolean" },
            "summary": { "type": "string" },
            "wheels": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "version": { "type": "string" },
                  "platformTag": { "type": "string" },
                  "sizeBytes": { "type": "integer" },
                  "filename": { "type": "string" }
                }
              }
            }
          },
          "required": ["success", "summary"]
        }
      },
      "offlinepythonInitProject": {
        "description": "AI tool: initialize an offline-Python project in a writable directory.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "projectDir": { "type": "string", "description": "Absolute path of the writable project directory." }
          },
          "required": ["projectDir"]
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "success": { "type": "boolean" },
            "summary": { "type": "string" },
            "projectDir": { "type": "string", "nullable": true }
          },
          "required": ["success", "summary"]
        }
      },
      "offlinepythonVerify": {
        "description": "AI tool: verify an offline-build output against its manifest.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "projectDir": { "type": "string" },
            "scope": { "type": "string", "enum": ["ALL", "INTEGRITY", "SHA256"], "nullable": true }
          },
          "required": ["projectDir"]
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "success": { "type": "boolean" },
            "summary": { "type": "string" },
            "result": {
              "type": "object",
              "description": "Per-check outcomes; individual checks are null when out of scope.",
              "properties": {
                "sha256": { "type": "object", "nullable": true, "properties": {
                  "status": { "type": "string", "enum": ["PASS", "WARN", "FAIL"] },
                  "detail": { "type": "string", "nullable": true },
                  "problems": { "type": "array", "items": { "type": "string" } }
                }, "required": ["status"] },
                "fileIntegrity": { "type": "object", "nullable": true, "properties": {
                  "status": { "type": "string", "enum": ["PASS", "WARN", "FAIL"] },
                  "detail": { "type": "string", "nullable": true },
                  "problems": { "type": "array", "items": { "type": "string" } }
                }, "required": ["status"] },
                "wheels": { "type": "object", "nullable": true, "properties": {
                  "status": { "type": "string", "enum": ["PASS", "WARN", "FAIL"] },
                  "detail": { "type": "string", "nullable": true },
                  "problems": { "type": "array", "items": { "type": "string" } }
                }, "required": ["status"] },
                "requirements": { "type": "object", "nullable": true, "properties": {
                  "status": { "type": "string", "enum": ["PASS", "WARN", "FAIL"] },
                  "detail": { "type": "string", "nullable": true },
                  "problems": { "type": "array", "items": { "type": "string" } }
                }, "required": ["status"] },
                "manifest": { "type": "object", "nullable": true, "properties": {
                  "status": { "type": "string", "enum": ["PASS", "WARN", "FAIL"] },
                  "detail": { "type": "string", "nullable": true },
                  "problems": { "type": "array", "items": { "type": "string" } }
                }, "required": ["status"] }
              }
            }
          },
          "required": ["success", "summary"]
        }
      },
      "offlinepythonBuildStart": {
        "description": "AI tool: start an offline wheelhouse build and return its job id.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "projectDir": { "type": "string" },
            "executable": { "type": "string", "nullable": true, "description": "Python executable; null = auto-detect." }
          },
          "required": ["projectDir"]
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "success": { "type": "boolean" },
            "summary": { "type": "string" },
            "jobId": { "type": "string", "nullable": true }
          },
          "required": ["success", "summary"]
        }
      },
      "offlinepythonBuildStatus": {
        "description": "AI tool: poll a build job and return streamed logs plus its final result.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "jobId": { "type": "string" },
            "cursor": { "type": "integer", "minimum": 0 }
          },
          "required": ["jobId"]
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "success": { "type": "boolean" },
            "summary": { "type": "string" },
