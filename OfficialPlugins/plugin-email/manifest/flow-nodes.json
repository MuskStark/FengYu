{
  "flowNodes": [
    {
      "tool": "email_send_batch",
      "label": "Configure batch email",
      "color": "#4DDBBB",
      "icon": "mdi-email-send-outline",
      "inputs": [
        {
          "name": "accountId",
          "widget": "select",
          "title": "Sender account",
          "source": {
            "method": "email_accounts_list",
            "items": "accounts",
            "value": "id",
            "label": "email",
            "labelSecondary": "displayName"
          },
          "help": "Choose from the configured email accounts."
        },
        {
          "name": "recipientGroupTagIds",
          "widget": "select",
          "title": "Recipient group tags",
          "source": {
            "method": "email_tags_list",
            "items": "tags",
            "value": "id",
            "label": "name",
            "multiple": true
          },
          "description": "Each member of the selected groups receives their matching attachment.",
          "help": "Select one or more recipient groups."
        },
        {
          "name": "ccGroupTagIds",
          "widget": "select",
          "title": "CC group tags",
          "source": {
            "method": "email_tags_list",
            "items": "tags",
            "value": "id",
            "label": "name",
            "multiple": true
          },
          "description": "Members of these groups are copied on every message."
        },
        {
          "name": "inputDirectory",
          "title": "Attachment directory",
          "description": "Directory containing recipient-specific attachments.",
          "placeholder": "/share/outputs",
          "help": "Usually reference the outputDir of an upstream Excel split node.",
          "examples": [
            "/share/outputs/2026-08"
          ]
        },
        {
          "name": "commonAttachments",
          "title": "Common attachments",
          "advanced": true
        },
        {
          "name": "subject",
          "title": "Subject",
          "examples": [
            "[Automated] August report split results"
          ]
        },
        {
          "name": "plainText",
          "widget": "textarea",
          "title": "Body",
          "help": "Plain text body; use {{ }} to reference upstream values such as the split summary."
        }
      ],
      "outputs": [
        {
          "name": "summary",
          "title": "Preparation summary",
          "examples": [
            "Prepared 12 messages for 3 tagged groups"
          ]
        },
        {
          "name": "confirmation",
          "title": "Confirmation",
          "help": "Pass its ID to an Execute email send node.",
          "properties": {
            "confirmationId": {
              "title": "Confirmation ID",
              "examples": [
                "cfm_9f2a"
              ]
            },
            "expiresAt": {
              "title": "Expires at",
              "examples": [
                "2026-08-19T18:00:00"
              ]
            }
          },
          "examples": [
            {
              "confirmationId": "cfm_9f2a",
              "expiresAt": "2026-08-19T18:00:00"
            }
          ]
        }
      ],
      "help": "Prepare recipient-specific attachments from a directory. This creates a confirmation; connect Execute email send to actually deliver the messages."
    },
    {
      "tool": "confirm_send",
      "label": "Execute email send",
      "color": "#4DDBBB",
      "icon": "mdi-email-check-outline",
      "inputs": [
        {
          "name": "confirmationId",
          "title": "Confirmation ID",
          "description": "The confirmation.confirmationId returned by email_send_batch.",
          "help": "Reference confirmation.confirmationId from email_send_batch."
        }
      ],
      "outputs": [
        {
          "name": "send",
          "title": "Send result"
        }
      ],
      "help": "Use the confirmation from Configure batch email to authorize and execute delivery."
    }
  ]
}
