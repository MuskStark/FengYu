{
  "schemaVersion": 1,
  "id": "fan.summer.email",
  "name": "Email Center",
  "description": "Compose, batch-send, collect, and audit email with confirmation-first AI tools",
  "version": "4.0.0-alpha.8",
  "author": "FengYu",
  "icon": "email-multiple",
  "category": "network",
  "ui": { "entry": "ui/index.html" },
  "backend": { "command": "java -jar backend/worker.jar", "protocol": "json-rpc-2.0" },
  "permissions": ["database", "network.email", "files.read", "files.write"],
  "homepage": "https://github.com/MuskStark/FengYu",
  "official": true,
  "aiTools": [
    {"name":"email_accounts_list","effect":"read","description":"List configured email accounts without returning credentials.","method":"email_accounts_list","inputSchema":"{\"type\":\"object\",\"properties\":{}}","outputSchema":"{\"type\":\"object\",\"properties\":{\"success\":{\"type\":\"boolean\"},\"summary\":{\"type\":\"string\"},\"accounts\":{\"type\":\"array\",\"description\":\"Configured accounts without credentials\",\"items\":{\"type\":\"object\"}}},\"required\":[\"success\",\"summary\"]}"},
    {"name":"email_contacts_query","effect":"read","description":"Search contacts and tags for recipient planning.","method":"email_contacts_query","inputSchema":"{\"type\":\"object\",\"properties\":{\"query\":{\"type\":\"string\",\"title\":\"Search text\"},\"tagIds\":{\"type\":\"array\",\"title\":\"Tag IDs\",\"items\":{\"type\":\"integer\"}},\"offset\":{\"type\":\"integer\",\"title\":\"Offset\",\"default\":0,\"minimum\":0},\"limit\":{\"type\":\"integer\",\"title\":\"Page size\",\"default\":50,\"minimum\":1,\"maximum\":100}}}","outputSchema":"{\"type\":\"object\",\"properties\":{\"success\":{\"type\":\"boolean\"},\"summary\":{\"type\":\"string\"},\"contacts\":{\"type\":\"array\",\"description\":\"Matching contacts\",\"items\":{\"type\":\"object\"}}},\"required\":[\"success\",\"summary\"]}"},
    {"name":"email_send_single","effect":"read","description":"Prepare direct or tag-selected private messages for confirmation; this call does not send.","method":"email_send_single","inputSchema":"{\"type\":\"object\",\"properties\":{\"accountId\":{\"type\":\"integer\",\"title\":\"Account ID\"},\"to\":{\"type\":\"array\",\"title\":\"To\",\"items\":{\"type\":\"string\"}},\"recipientTagIds\":{\"type\":\"array\",\"title\":\"Recipient tag IDs\",\"items\":{\"type\":\"integer\"}},\"cc\":{\"type\":\"array\",\"title\":\"CC\",\"items\":{\"type\":\"string\"}},\"bcc\":{\"type\":\"array\",\"title\":\"BCC\",\"items\":{\"type\":\"string\"}},\"subject\":{\"type\":\"string\",\"title\":\"Subject\"},\"plainText\":{\"type\":\"string\",\"title\":\"Plain-text body\"},\"htmlText\":{\"type\":\"string\",\"title\":\"HTML body\"},\"attachments\":{\"type\":\"array\",\"title\":\"Attachments\",\"items\":{\"type\":\"object\"}}},\"required\":[\"accountId\"]}","outputSchema":"{\"type\":\"object\",\"properties\":{\"success\":{\"type\":\"boolean\"},\"summary\":{\"type\":\"string\"},\"confirmation_required\":{\"type\":\"boolean\"},\"confirmation\":{\"type\":\"object\",\"description\":\"Prepared send confirmation including confirmationId\"}},\"required\":[\"success\",\"summary\"]}"},
    {"name":"email_send_batch","effect":"read","description":"Prepare attachment-matched batch messages for confirmation without sending.","method":"email_send_batch","inputSchema":"{\"type\":\"object\",\"properties\":{\"accountId\":{\"type\":\"integer\",\"title\":\"Account ID\"},\"recipientGroupTagIds\":{\"type\":\"array\",\"title\":\"Recipient group tag IDs\",\"items\":{\"type\":\"integer\"}},\"ccGroupTagIds\":{\"type\":\"array\",\"title\":\"CC group tag IDs\",\"items\":{\"type\":\"integer\"}},\"inputDirectory\":{\"type\":\"object\",\"title\":\"Attachment directory\"},\"commonAttachments\":{\"type\":\"array\",\"title\":\"Common attachments\",\"items\":{\"type\":\"object\"}},\"subject\":{\"type\":\"string\",\"title\":\"Subject\"},\"plainText\":{\"type\":\"string\",\"title\":\"Plain-text body\"},\"htmlText\":{\"type\":\"string\",\"title\":\"HTML body\"}},\"required\":[\"accountId\",\"recipientGroupTagIds\",\"ccGroupTagIds\",\"inputDirectory\"]}","outputSchema":"{\"type\":\"object\",\"properties\":{\"success\":{\"type\":\"boolean\"},\"summary\":{\"type\":\"string\"},\"confirmation_required\":{\"type\":\"boolean\"},\"confirmation\":{\"type\":\"object\",\"description\":\"Prepared batch confirmation including confirmationId\"}},\"required\":[\"success\",\"summary\"]}"},
    {"name":"email_send_status","effect":"read","description":"Query a prepared or completed send by confirmation ID.","method":"email_send_status","inputSchema":"{\"type\":\"object\",\"properties\":{\"confirmationId\":{\"type\":\"string\",\"title\":\"Confirmation ID\"}},\"required\":[\"confirmationId\"]}","outputSchema":"{\"type\":\"object\",\"properties\":{\"success\":{\"type\":\"boolean\"},\"summary\":{\"type\":\"string\"},\"send\":{\"type\":\"object\",\"description\":\"Prepared or completed send status\"}},\"required\":[\"success\",\"summary\"]}"},
    {"name":"email_archive_fetch","effect":"external","description":"Collect messages from an IMAP folder into an authorized output directory.","method":"email_archive_fetch","inputSchema":"{\"type\":\"object\",\"properties\":{\"accountId\":{\"type\":\"integer\",\"title\":\"Account ID\"},\"folder\":{\"type\":\"string\",\"title\":\"IMAP folder\"},\"start\":{\"type\":\"string\",\"title\":\"Start time\",\"format\":\"date-time\"},\"end\":{\"type\":\"string\",\"title\":\"End time\",\"format\":\"date-time\"},\"outputDirectory\":{\"type\":\"object\",\"title\":\"Output directory\"}},\"required\":[\"accountId\",\"folder\",\"outputDirectory\"]}","outputSchema":"{\"type\":\"object\",\"properties\":{\"success\":{\"type\":\"boolean\"},\"summary\":{\"type\":\"string\"},\"collection\":{\"type\":\"object\",\"description\":\"New, duplicate, and failed message counts\"}},\"required\":[\"success\",\"summary\"]}"},
    {"name":"email_archive_query","effect":"read","description":"Search paginated archived email metadata without exposing message bodies.","method":"email_archive_query","inputSchema":"{\"type\":\"object\",\"properties\":{\"accountId\":{\"type\":\"integer\",\"title\":\"Account ID\"},\"folder\":{\"type\":\"string\",\"title\":\"Folder\"},\"sender\":{\"type\":\"string\",\"title\":\"Sender\"},\"subject\":{\"type\":\"string\",\"title\":\"Subject\"},\"start\":{\"type\":\"string\",\"title\":\"Start time\",\"format\":\"date-time\"},\"end\":{\"type\":\"string\",\"title\":\"End time\",\"format\":\"date-time\"},\"offset\":{\"type\":\"integer\",\"title\":\"Offset\",\"default\":0,\"minimum\":0},\"limit\":{\"type\":\"integer\",\"title\":\"Page size\",\"default\":50,\"minimum\":1,\"maximum\":100}}}","outputSchema":"{\"type\":\"object\",\"properties\":{\"success\":{\"type\":\"boolean\"},\"summary\":{\"type\":\"string\"},\"messages\":{\"type\":\"array\",\"description\":\"Matching archived message metadata\",\"items\":{\"type\":\"object\"}}},\"required\":[\"success\",\"summary\"]}"},
    {"name":"email_account_test","effect":"external","description":"Test the SMTP connection for a saved account without sending mail.","method":"email_account_test","inputSchema":"{\"type\":\"object\",\"properties\":{\"accountId\":{\"type\":\"integer\",\"title\":\"Account ID\"}},\"required\":[\"accountId\"]}","outputSchema":"{\"type\":\"object\",\"properties\":{\"success\":{\"type\":\"boolean\"},\"summary\":{\"type\":\"string\"}},\"required\":[\"success\",\"summary\"]}"},
    {"name":"email_account_test_imap","effect":"external","description":"Test the IMAP connection for a saved account without fetching mail.","method":"email_account_test_imap","inputSchema":"{\"type\":\"object\",\"properties\":{\"accountId\":{\"type\":\"integer\",\"title\":\"Account ID\"}},\"required\":[\"accountId\"]}","outputSchema":"{\"type\":\"object\",\"properties\":{\"success\":{\"type\":\"boolean\"},\"summary\":{\"type\":\"string\"}},\"required\":[\"success\",\"summary\"]}"}
  ],
  "i18n": {
    "zh": {
      "name": "邮件中心",
      "description": "撰写、批量发送、收取并审计邮件，采用确认优先的 AI 工具",
      "aiTools": {
        "email_accounts_list": { "description": "列出已配置的邮件账户，不返回凭据。" },
        "email_contacts_query": { "description": "搜索联系人与标签以规划收件人。" },
        "email_send_single": { "description": "准备直发或按标签选择的私信以供确认；此调用不会发送。" },
        "email_send_batch": { "description": "准备附件匹配的批量邮件以供确认，但不发送。" },
        "email_send_status": { "description": "按确认 ID 查询已准备或已完成的发送。" },
        "email_archive_fetch": { "description": "将 IMAP 文件夹中的邮件收集到已授权的输出目录。" },
        "email_archive_query": { "description": "分页搜索已归档邮件元数据，不暴露邮件正文。" },
        "email_account_test": { "description": "测试已保存账户的 SMTP 连接，不发送邮件。" },
        "email_account_test_imap": { "description": "测试已保存账户的 IMAP 连接，不收取邮件。" }
      }
    }
  }
}
