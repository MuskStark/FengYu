{
  "schemaVersion": 2,
  "id": "fan.summer.email",
  "name": "Email Center",
  "description": "Compose, batch-send, collect, and audit email with confirmation-first AI tools",
  "version": "4.0.0-rc.1",
  "engines": {
    "fengyu": ">=4.0.0-rc.1 <5.0.0"
