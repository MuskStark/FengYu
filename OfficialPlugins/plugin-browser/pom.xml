<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>fan.summer.fengyu</groupId>
        <artifactId>FengYu-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <groupId>fan.summer.fengyu.plugin</groupId>
    <artifactId>plugin-browser</artifactId>
    <name>FengYu Browser Plugin</name>

    <dependencies>
        <dependency>
            <groupId>fan.summer.fengyu.sdk</groupId>
            <artifactId>fengyu-plugin-sdk</artifactId>
        </dependency>
        <dependency>
            <groupId>com.microsoft.playwright</groupId>
            <artifactId>playwright</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>fan.summer.fengyu.sdk</groupId>
            <artifactId>fengyu-plugin-devkit</artifactId>
            <version>${fengyu.plugin.sdk.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Mockito for unit-testing the Playwright lifecycle without a real browser.
             Not managed in FengYu-parent's dependencyManagement; pinned to 5.23.0,
             the version the Spring Boot 4.1 BOM resolves for the FengYu host. -->
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>5.23.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- Playwright's driver-bundle ships Node.js binaries for ALL platforms
         (~570MB unpacked, ~190MB shaded). The antrun step below runs after shade
         and strips the four non-current-platform driver/<platform>/ trees, keeping
         only the build host's platform so the worker JAR stays well under the
         100MB .fyp limit. Build once per target platform to produce
         platform-specific .fyp packages; override with
         -Dplaywright.driver.platform=<mac|mac-arm64|linux|linux-arm64|win32_x64>. -->
    <profiles>
        <profile>
            <id>driver-mac-arm64</id>
            <activation><os><family>mac</family><arch>aarch64</arch></os></activation>
            <properties><playwright.driver.platform>mac-arm64</playwright.driver.platform></properties>
        </profile>
        <profile>
            <id>driver-mac-x64</id>
            <activation><os><family>mac</family><arch>x86_64</arch></os></activation>
            <properties><playwright.driver.platform>mac</playwright.driver.platform></properties>
        </profile>
        <profile>
            <id>driver-linux-x64</id>
            <activation><os><family>unix</family><name>Linux</name><arch>x86_64</arch></os></activation>
            <properties><playwright.driver.platform>linux</playwright.driver.platform></properties>
        </profile>
        <!-- Temurin reports x64 as "amd64" on GitHub-hosted Linux runners. -->
        <profile>
            <id>driver-linux-amd64</id>
            <activation><os><family>unix</family><name>Linux</name><arch>amd64</arch></os></activation>
            <properties><playwright.driver.platform>linux</playwright.driver.platform></properties>
        </profile>
        <profile>
            <id>driver-linux-arm64</id>
            <activation><os><family>unix</family><name>Linux</name><arch>aarch64</arch></os></activation>
            <properties><playwright.driver.platform>linux-arm64</playwright.driver.platform></properties>
        </profile>
        <profile>
            <id>driver-win-x64</id>
            <activation><os><family>windows</family><arch>x86_64</arch></os></activation>
            <properties><playwright.driver.platform>win32_x64</playwright.driver.platform></properties>
        </profile>
        <profile>
            <id>driver-win-amd64</id>
            <activation><os><family>windows</family><arch>amd64</arch></os></activation>
            <properties><playwright.driver.platform>win32_x64</playwright.driver.platform></properties>
        </profile>
    </profiles>

    <build>
        <finalName>browser-worker</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <finalName>browser-worker</finalName>
                            <shadedArtifactAttached>false</shadedArtifactAttached>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <minimizeJar>false</minimizeJar>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>fan.summer.fengyu.plugin.browser.BrowserWorkerMain</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- After shade, strip the four non-current-platform Node driver trees
                 from the shaded JAR. Playwright bundles all 5 platforms (~570MB);
                 keeping one drops the JAR from ~190MB to ~40-50MB, under the .fyp limit.
                 Requires ${playwright.driver.platform} (set by the profiles above). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                    <execution>
                        <id>strip-non-current-driver-platforms</id>
                        <phase>package</phase>
                        <goals><goal>run</goal></goals>
                        <configuration>
                            <!-- A missing/unknown platform must never leave the all-platform
                                 Playwright bundle in a deceptively successful oversized JAR. -->
                            <failOnError>true</failOnError>
                            <target>
                                <condition property="platform.set">
                                    <isset property="playwright.driver.platform"/>
                                </condition>
                                <fail message="playwright.driver.platform is not set (no OS profile activated)">
                                    <condition><not><isset property="platform.set"/></not></condition>
                                </fail>
                                <unzip src="${project.build.directory}/browser-worker.jar"
                                       dest="${project.build.directory}/browser-worker-unpacked"/>
                                <!-- Delete every driver/<platform>/ except the current one. -->
                                <delete includeemptydirs="true">
                                    <fileset dir="${project.build.directory}/browser-worker-unpacked/driver">
                                        <include name="*/**"/>
                                        <exclude name="${playwright.driver.platform}/**"/>
                                    </fileset>
                                </delete>
                                <delete file="${project.build.directory}/browser-worker.jar"/>
                                <zip destfile="${project.build.directory}/browser-worker.jar"
                                     basedir="${project.build.directory}/browser-worker-unpacked"
                                     keepcompression="true"/>
                                <delete dir="${project.build.directory}/browser-worker-unpacked"/>
                                <echo message="browser-worker.jar: kept driver/${playwright.driver.platform}, stripped others"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
