<?xml version="1.0" encoding="UTF-8"?>
<!--
    Release-only Maven settings for publishing the Java Worker SDK to GitHub
    Packages. Credentials are injected from the environment (GITHUB_ACTOR +
    FENGYU_GITHUB_TOKEN); this file never contains a literal token and is NOT
    bundled into any .fyp (it lives at the repo root, outside plugin roots).
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
  <servers>
    <server>
      <id>github</id>
      <username>${env.GITHUB_ACTOR}</username>
      <password>${env.FENGYU_GITHUB_TOKEN}</password>
    </server>
  </servers>
</settings>
