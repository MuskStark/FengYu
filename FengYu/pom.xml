<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>fan.summer.fengyu</groupId>
        <artifactId>FengYu-parent</artifactId>
        <version>4.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>FengYu</artifactId>

    <name>FengYu</name>
    <description>FengYu — a modular desktop toolbox.</description>

    <properties>
        <!-- Most version pins are inherited from the parent. The two Spring BOM pins
             are declared here because they are consumed by this module's own
             dependencyManagement import below (a property defined in the same POM
             always resolves for that POM's import-scoped BOM version). -->
        <spring-boot.version>4.1.0</spring-boot.version>
        <spring-ai.version>2.0.0</spring-ai.version>
    </properties>

    <!-- Import-scoped BOMs live here (not in the parent): import BOMs in a parent POM
         do not reliably propagate managed versions to child modules. Version pins come
         from parent <properties> (spring-boot.version / spring-ai.version). -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Pin BOTH logback artifacts to the same version. The Spring Boot BOM manages
                 logback-classic to an older version (1.5.6) than the logback-core resolved via
                 the parent (1.5.34); that split pair throws ClassNotFoundException on internal
                 classes (e.g. JaninoEventEvaluatorBase) at first logger init. These direct
                 entries win over the imported BOM and keep classic + core aligned. -->
            <dependency>
                <groupId>ch.qos.logback</groupId>
                <artifactId>logback-classic</artifactId>
                <version>${logback.version}</version>
            </dependency>
            <dependency>
                <groupId>ch.qos.logback</groupId>
                <artifactId>logback-core</artifactId>
                <version>${logback.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>

        <!-- FengYu-Api: bundled in fat-JAR at runtime so plugins can load against it -->
        <dependency>
            <groupId>fan.summer.fengyu.api</groupId>
            <artifactId>FengYu-Api</artifactId>
        </dependency>

        <!-- Official Markdown plugin (v2): compile-time bundled. Its @Component is picked up by
             the broadened component scan and its ui/ resources are served at /plugin-ui/markdown/. -->
        <dependency>
            <groupId>fan.summer.fengyu.plugin</groupId>
            <artifactId>plugin-markdown</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- Official Excel plugin (v2): compile-time bundled; ui served at /plugin-ui/excel/. -->
        <dependency>
            <groupId>fan.summer.fengyu.plugin</groupId>
            <artifactId>plugin-excel</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- JavaFX removed in 4.0.0 Phase 1 headless cutover: the UI is now Vue + Tauri and the
             backend is a headless Spring Boot web server. No javafx.* code remains. -->

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>

        <!-- Excel -->
        <dependency>
            <groupId>org.apache.fesod</groupId>
            <artifactId>fesod-sheet</artifactId>
        </dependency>

        <!-- H2 Database -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
        </dependency>

        <!-- Spring Data JPA + Hibernate (replaces MyBatis) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Actuator for /restart endpoint (Web deployment setup completion) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Multi-datasource JDBC drivers (runtime) -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Hibernate community dialects: SQLiteDialect (not in core Hibernate) -->
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-community-dialects</artifactId>
        </dependency>

        <!-- Email -->
        <dependency>
            <groupId>org.simplejavamail</groupId>
            <artifactId>simple-java-mail</artifactId>
        </dependency>

        <!-- MigLayout (for legacy Swing components pending JavaFX migration) -->
        <dependency>
            <groupId>com.miglayout</groupId>
            <artifactId>miglayout-swing</artifactId>
        </dependency>

        <!-- Force override vulnerable version transitively brought in by simple-java-mail -->
        <dependency>
            <groupId>org.eclipse.angus</groupId>
            <artifactId>angus-mail</artifactId>
        </dependency>

        <!-- Gson -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
        </dependency>

        <!-- Commonmark (Markdown rendering) -->
        <dependency>
            <groupId>org.commonmark</groupId>
            <artifactId>commonmark</artifactId>
        </dependency>

        <!-- PDF -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
        </dependency>

        <!-- Document conversion: PDF to DOCX (pure Java via PDFBox + Apache POI) -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
        </dependency>

        <!-- Playwright (Browser Automation) -->
        <dependency>
            <groupId>com.microsoft.playwright</groupId>
            <artifactId>playwright</artifactId>
        </dependency>

        <!-- Spring Boot (embedded): DI + auto-config backbone for the AI context. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!-- Spring Boot web (embedded Tomcat) for Phase 1 headless server -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Spring AI 2.0 — manual @Bean configuration (no starter-model auto-config).
             Non-starter artifacts so WebApplicationType.NONE has no auto-config surprises. -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-openai</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-anthropic</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-ollama</artifactId>
        </dependency>
        <dependency>
            <!-- ChatClient + ToolCallingManager + ChatClientMessageAggregator (user-controlled
                 tool execution path). Brings the non-deprecated Spring AI 2.0 chat-client API
                 onto the classpath; version managed by the spring-ai-bom import above. -->
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-client-chat</artifactId>
        </dependency>

        <!-- Logging: slf4j API + logback binding -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
        </dependency>

        <!-- JUnit 5 (test scope) — pure-logic unit tests only -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Spring Boot test support (MockMvc / TestRestTemplate) for the headless web layer.
             Version managed by the spring-boot-dependencies BOM. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- @DataJpaTest (Spring Boot 4.x): the slice moved into its own module
             org.springframework.boot.data.jpa.test.autoconfigure. Version managed by BOM. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-data-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <profile>
            <id>windows-exe</id>
            <activation>
                <os>
                    <family>windows</family>
                </os>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.akathist.maven.plugins.launch4j</groupId>
                        <artifactId>launch4j-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>l4j-clui</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>launch4j</goal>
                                </goals>
                                <configuration>
                                    <headerType>gui</headerType>
                                    <outfile>target/FengYu.exe</outfile>
                                    <jar>target/FengYu-${project.version}.jar</jar>
                                    <icon>src/main/resources/icons/FengYu.ico</icon>
                                    <errTitle>FengYu Error</errTitle>
                                    <downloadUrl>https://adoptium.net/</downloadUrl>
                                    <supportUrl>https://github.com/MuskStark/FengYu</supportUrl>
                                    <jre>
                                        <minVersion>17</minVersion>
                                        <jdkPreference>preferJre</jdkPreference>
                                        <runtimeBits>64/32</runtimeBits>
                                    </jre>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <build>
        <resources>
            <!-- Default: all resources unfiltered, so binary assets (images, fonts) aren't corrupted. -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
            </resource>
            <!-- build-info.properties is the only filtered resource: ${project.version} / ${maven.build.timestamp} are replaced at build time. -->
            <resource>
                <directory>src/main/resources</directory>
                <includes>
                    <include>build-info.properties</include>
                </includes>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <!-- Maven Shade Plugin (version inherited from parent pluginManagement) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <filters>
                                <filter>
                                    <artifact>org.openjfx:*</artifact>
                                    <excludes>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer
                                        implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>fan.summer.fengyu.HeadlessLauncher</mainClass>
                                    <manifestEntries>
                                        <Implementation-Version>${project.version}</Implementation-Version>
                                    </manifestEntries>
                                </transformer>
                                <transformer
                                        implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <!-- Spring Boot 4 splits autoconfigurations across many module jars,
                                     each shipping its OWN AutoConfiguration.imports at the same resource
                                     path. Without appending, shade keeps only one file and web/Tomcat
                                     autoconfig never loads (embedded Tomcat silently doesn't start).
                                     Append-merge all of them, plus the legacy spring.factories. -->
                                <transformer
                                        implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                                    <resource>META-INF/spring/org.springframework.boot.autoconfigure.AutoConfiguration.imports</resource>
                                </transformer>
                                <transformer
                                        implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                                    <resource>META-INF/spring.factories</resource>
                                </transformer>
                            </transformers>
                            <finalName>FengYu-${project.version}</finalName>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Maven Compiler Plugin (version inherited from parent pluginManagement). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>${maven.compiler.source}</source>
                    <target>${maven.compiler.target}</target>
                    <encoding>UTF-8</encoding>
                    <!-- -parameters: retain method parameter names so Spring MVC can resolve
                         @PathVariable / @RequestParam by name via reflection (this config block
                         overrides the Spring Boot parent default that would otherwise add it). -->
                    <parameters>true</parameters>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <!-- Surefire: run JUnit 5 tests (version inherited) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
