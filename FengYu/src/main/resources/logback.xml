<?xml version="1.0" encoding="UTF-8"?>
<!--
  FengYu logging configuration.

  The host application sets the system property `fengyu.log.dir` to the absolute
  path of the runtime log directory (typically `<program-working-directory>/.fengyu/logs/`) before SLF4J
  initialises. A fallback default keeps the
  config valid when logback is loaded outside the host (tests, IDE).
-->
<configuration scan="true" scanPeriod="30 seconds">

    <!-- Fallback for isolated tests/tools that do not enter through HeadlessLauncher. -->
    <property name="LOG_DIR" value="${fengyu.log.dir:-.fengyu/logs}"/>

    <!-- ── Console: threshold follows the host-wide logger level ────────── -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- ── Rolling file: shared threshold, daily rotation, 7-day retention ─── -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/fengyu.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/fengyu.%d{yyyy-MM-dd}.log.gz</fileNamePattern>
            <maxHistory>7</maxHistory>
            <totalSizeCap>200MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- ── Per-plugin rolling file: keyed by MDC "pluginId", set by PluginProcessManager.
              Each plugin's forwarded events are persisted to <LOG_DIR>/plugin-<pluginId>.log,
              rolling at 10MB and daily, kept 7 days, capped at 50MB total per plugin.
              additivity stays true so fengyu.log (the shared FILE appender at root) still gets
              every event too. PLUGIN_FILE is referenced on the "plugin" logger below. -->
    <appender name="PLUGIN_FILE" class="ch.qos.logback.classic.sift.SiftingAppender">
        <discriminator class="ch.qos.logback.classic.sift.MDCBasedDiscriminator">
            <key>pluginId</key>
            <defaultValue>unknown</defaultValue>
        </discriminator>
        <sift>
            <appender name="PLUGIN_FILE-${pluginId}" class="ch.qos.logback.core.rolling.RollingFileAppender">
                <file>${LOG_DIR}/plugin-${pluginId}.log</file>
                <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                    <fileNamePattern>${LOG_DIR}/plugin-${pluginId}.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
                    <maxFileSize>10MB</maxFileSize>
                    <maxHistory>7</maxHistory>
                    <totalSizeCap>50MB</totalSizeCap>
                </rollingPolicy>
                <encoder>
                    <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger - %msg%n</pattern>
                    <charset>UTF-8</charset>
                </encoder>
            </appender>
        </sift>
    </appender>

    <!-- ── Tame the noisy frameworks ────────────────────────────────────── -->
    <logger name="org.apache.ibatis"   level="WARN"/>
    <logger name="org.mybatis"          level="WARN"/>
    <logger name="org.simplejavamail"   level="INFO"/>
    <logger name="org.eclipse.angus"    level="WARN"/>
    <logger name="com.h2database"       level="WARN"/>
    <logger name="org.apache.poi"       level="WARN"/>
    <logger name="org.apache.fesod"     level="WARN"/>
    <logger name="javafx"               level="INFO"/>

    <!-- Defaults are replaced at runtime by LoggingLevelService. -->
    <logger name="fan.summer"           level="INFO"/>
    <logger name="plugin" level="INFO" additivity="true">
        <appender-ref ref="PLUGIN_FILE"/>
    </logger>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>
