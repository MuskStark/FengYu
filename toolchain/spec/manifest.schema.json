{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://fengyu.dev/plugin/manifest.schema.json",
  "title": "FengYu plugin manifest",
  "description": "FengYu plugin manifest schema v2. The manifest is the single hand-written plugin contract; inputSchema/outputSchema are JSON-Schema objects (not escaped strings) declared once per RPC method on rpc.methods, and aiTools reference those methods by name. additionalProperties is false throughout so the contract is total and generator/host drift is caught at validation time.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "description",
    "version",
    "author",
    "icon",
    "category",
    "ui"
  ],
  "definitions": {
    "jsonSchemaSubset": {
      "type": "object",
      "description": "The JSON-Schema subset the v2 generator supports: object, array, string, integer, number, boolean, plus enum/required/nullable. Anything outside this set must be rejected by the generator rather than silently coerced to a generic type.",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "object",
            "array",
            "string",
            "integer",
            "number",
            "boolean"
          ]
        },
        "title": {
          "type": "string",
          "description": "Human-facing label; UI surfaces use it instead of the raw field name."
        },
        "description": {
          "type": "string"
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/jsonSchemaSubset"
          }
        },
        "items": {
          "$ref": "#/definitions/jsonSchemaSubset"
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "enum": {
          "type": "array",
          "minItems": 1
        },
        "nullable": {
          "type": "boolean"
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "x-fengyu-advanced": {
          "type": "boolean",
          "description": "Canvas-only presentation hint: fold this input into the flow node's Advanced settings section instead of the main input form."
        },
        "x-fengyu-options-from": {
          "type": "string",
          "description": "Canvas-only presentation hint: datalist candidates for this input (workbook-sheets / workbook-columns) fed by an x-fengyu-analyze workbook analysis."
        },
        "x-fengyu-analyze": {
          "type": "string",
          "description": "Canvas-only presentation hint: render an analyze affordance beside this input (currently 'excel')."
        }
      }
    },
    "inputSchema": {
      "type": "object",
      "description": "A method's input schema. RPC inputs are always objects, so the top-level type is pinned to \"object\".",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "const": "object"
        },
        "description": {
          "type": "string"
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/jsonSchemaSubset"
          }
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "additionalProperties": {
          "type": "boolean"
        }
      }
    },
    "outputSchema": {
      "type": "object",
      "description": "A method's output schema. Outputs are object envelopes, so the top-level type is pinned to \"object\".",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "const": "object"
        },
        "description": {
          "type": "string"
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/jsonSchemaSubset"
          }
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "additionalProperties": {
          "type": "boolean"
        }
      }
    },
    "rpcMethod": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputSchema"
      ],
      "properties": {
        "description": {
          "type": "string"
        },
        "inputSchema": {
          "$ref": "#/definitions/inputSchema"
        },
        "outputSchema": {
          "$ref": "#/definitions/outputSchema"
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        }
      }
    },
    "localeOverride": {
      "type": "object",
      "additionalProperties": false,
      "description": "Locale-specific overrides for the manifest's display strings. Every field is independently optional; the host falls back to the top-level (default, English) field whenever an override is absent.",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "aiTools": {
          "type": "object",
          "description": "Per-tool display overrides keyed by tool `name` (stable across versions). Each entry may override `name` and/or `description`; these are frontend-only and never reach the LLM.",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "flowValueType": {
      "type": "string",
      "enum": [
        "string",
        "number",
        "boolean",
        "object",
        "array",
        "file",
        "any"
      ],
      "description": "Flow-canvas data type. 'any' (the default when omitted) connects to everything without type checking; 'file' matches FengYu file references (fengyu-file)."
    },
    "flowNodeInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "widget"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "Tool argument this input edits."
        },
        "widget": {
          "type": "string",
          "enum": [
            "text",
            "number",
            "switch",
            "select",
            "textarea",
            "json",
            "analyze",
            "rows"
          ],
          "description": "Canvas widget used to edit the value."
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "type": {
          "$ref": "#/definitions/flowValueType",
          "description": "Expected value type; drives the variable picker's type filter and binding-time warnings. Omitted = any."
        },
        "required": {
          "type": "boolean",
          "description": "Marks the field as required on the canvas in addition to the tool schema's required list."
        },
        "placeholder": {
          "type": "string",
          "description": "Input placeholder shown before a value is typed."
        },
        "examples": {
          "type": "array",
          "description": "Example values; the first one doubles as the manual-editor placeholder."
        },
        "help": {
          "type": "string",
          "description": "One-line field-level hint, shown closer to the input than description."
        },
        "advanced": {
          "type": "boolean",
          "description": "Fold this input into the node's Advanced settings section."
        },
        "options": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "value"
                ],
                "properties": {
                  "value": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  }
                }
              }
            ]
          },
          "minItems": 1,
          "description": "Choices for widget=select: plain values or {value,label} pairs for localized labels."
        },
        "default": {},
        "optionsFrom": {
          "type": "string",
          "enum": [
            "workbook-sheets",
            "workbook-columns"
          ],
          "description": "Datalist source for widget=text inputs."
        },
        "fields": {
          "type": "array",
          "description": "Per-row fields for widget=rows.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "widget"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "widget": {
                "type": "string",
                "enum": [
                  "text",
                  "number",
                  "switch",
                  "select"
                ]
              },
              "title": {
                "type": "string"
              },
              "optionsFrom": {
                "type": "string",
                "enum": [
                  "workbook-sheets",
                  "workbook-columns"
                ]
              },
              "optionsFromContext": {
                "$ref": "#/definitions/flowNodeOptionsFromContext"
              }
            }
          }
        },
        "source": {
          "$ref": "#/definitions/flowNodeOptionSource"
        },
        "context": {
          "$ref": "#/definitions/flowNodeContext"
        },
        "optionsFromContext": {
          "$ref": "#/definitions/flowNodeOptionsFromContext"
        }
      }
    },
    "flowOutputProperty": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "$ref": "#/definitions/flowValueType"
        },
        "title": {
          "type": "string",
          "description": "Human-facing label; the output tree shows it instead of the raw field name."
        },
        "description": {
          "type": "string"
        },
        "examples": {
          "type": "array",
          "description": "Example values shown when no run data exists yet."
        },
        "properties": {
          "type": "object",
          "description": "Nested fields of an object output; the variable tree renders them recursively.",
          "additionalProperties": {
            "$ref": "#/definitions/flowOutputProperty"
          }
        },
        "items": {
          "$ref": "#/definitions/flowOutputProperty",
          "description": "Element shape of an array output."
        }
      }
    },
    "flowNodeOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "type": {
          "$ref": "#/definitions/flowValueType",
          "description": "Port data type; colors the output handle and filters the variable picker."
        },
        "description": {
          "type": "string",
          "description": "Shown in the port tooltip."
        },
        "help": {
          "type": "string",
          "description": "Usage hint shown in the output viewer."
        },
        "examples": {
          "type": "array",
          "description": "Example values; the output viewer shows them until a real run provides data."
        },
        "properties": {
          "type": "object",
          "description": "Nested fields of an object output (descriptor v2).",
          "additionalProperties": {
            "$ref": "#/definitions/flowOutputProperty"
          }
        },
        "items": {
          "$ref": "#/definitions/flowOutputProperty",
          "description": "Element shape of an array output (descriptor v2)."
        }
      }
    },
    "flowNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool"
      ],
      "properties": {
        "tool": {
          "type": "string",
          "description": "aiTool name this node renders and executes."
        },
        "label": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "action",
            "control",
            "start"
          ],
          "description": "Node kind: action (default) executes a tool; control/start are canvas-authored structural nodes."
        },
        "help": {
          "type": "string",
          "description": "Node-level help shown in the inspector's help drawer (Markdown)."
        },
        "docsUrl": {
          "type": "string",
          "description": "Optional external documentation link."
        },
        "color": {
          "type": "string",
          "description": "Hex color for the node card and ports."
        },
        "icon": {
          "type": "string",
          "description": "MDI icon name for the badge."
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/flowNodeInput"
          }
        },
        "outputs": {
          "type": "array",
          "description": "Named output ports.",
          "items": {
            "$ref": "#/definitions/flowNodeOutput"
          }
        }
      }
    },
    "flowNodeOptionSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "value",
        "label"
      ],
      "properties": {
        "method": {
          "type": "string",
          "description": "Plugin RPC list method backing the options."
        },
        "items": {
          "type": "string",
          "description": "Result field holding the option list."
        },
        "value": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "labelSecondary": {
          "type": "string"
        },
        "multiple": {
          "type": "boolean",
          "description": "Render a multi-select (array value)."
        }
      }
    },
    "flowNodeContextFeed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "list"
      ],
      "properties": {
        "list": {
          "type": "string",
          "description": "Result field holding the list."
        },
        "item": {
          "type": "string",
          "description": "Flat feed: field of each entry."
        },
        "key": {
          "type": "string",
          "description": "Keyed feed: field to group entries by."
        },
        "items": {
          "type": "string",
          "description": "Keyed feed: nested list field of each entry."
        },
        "itemField": {
          "type": "string",
          "description": "Keyed feed: field within each nested item."
        }
      }
    },
    "flowNodeContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "feeds"
      ],
      "properties": {
        "method": {
          "type": "string"
        },
        "params": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Call params; \"{{value}}\" templates the input value."
        },
        "sessionScope": {
          "type": "string",
          "enum": [
            "node"
          ]
        },
        "feeds": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/flowNodeContextFeed"
          }
        }
      }
    },
    "flowNodeOptionsFromContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "set"
      ],
      "properties": {
        "set": {
          "type": "string",
          "description": "Feed name to read options from."
        },
        "keyedBy": {
          "type": "string",
          "description": "Row field whose value selects the keyed bucket."
        }
      }
    }
  },
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+].+)?$"
    },
    "author": {
      "type": "string",
      "minLength": 1
    },
    "icon": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "homepage": {
      "type": "string"
    },
    "official": {
      "type": "boolean"
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry"
      ],
      "properties": {
        "entry": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "description": "Declares an out-of-process worker. The worker is fixed to backend/worker.jar speaking JSON-RPC 2.0; command/protocol are no longer expressed in the manifest. callTimeoutSeconds is the default per-call timeout.",
      "properties": {
        "callTimeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        }
      }
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "files.read",
          "files.write",
          "network",
          "network.email",
          "clipboard.read",
          "clipboard.write",
          "notifications",
          "database"
        ]
      }
    },
    "rpc": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "methods"
      ],
      "properties": {
        "methods": {
          "type": "object",
          "description": "The complete method table shared by the UI and AI. Every UI RPC and every aiTools.method must resolve to a key here. Method names are lowerCamelCase identifiers.",
          "patternProperties": {
            "^[a-zA-Z_][a-zA-Z0-9_]*$": {
              "$ref": "#/definitions/rpcMethod"
            }
          },
          "additionalProperties": false
        }
      }
    },
    "aiTools": {
      "type": "array",
      "description": "AI-facing tools. Each tool references an rpc.methods entry by `method`; input/output schemas are NOT duplicated here. `effect` is mandatory authorization metadata for AI-invokable capabilities.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "description",
          "method",
          "effect"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "method": {
            "type": "string",
            "minLength": 1
          },
          "effect": {
            "type": "string",
            "enum": [
              "read",
              "write",
              "external"
            ]
          },
          "timeoutSeconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 600
          }
        }
      }
    },
    "i18n": {
      "type": "object",
      "description": "Optional locale overrides for the manifest's display strings. Keys are short lowercased locale tags (e.g. \"en\", \"zh\"); the host resolves the request locale (Accept-Language) with language-family fallback (\"zh-CN\" -> \"zh\"), then falls back to the top-level default. RPC method schemas are never localized here.",
      "patternProperties": {
        "^[a-z]{2,3}(-[A-Za-z0-9]+)*$": {
          "$ref": "#/definitions/localeOverride"
        }
      },
      "additionalProperties": false
    },
    "flowNodes": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/flowNode"
      },
      "description": "Explicit flow-canvas node declarations; the builder renders these instead of deriving forms from aiTool schemas."
    }
  }
}
