{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://fengyu.dev/plugin/manifest.schema.json",
  "title": "FengYu plugin manifest",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "id", "name", "description", "version", "author", "icon", "category", "ui"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+].+)?$" },
    "author": { "type": "string", "minLength": 1 },
    "icon": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "minLength": 1 },
    "homepage": { "type": "string" },
    "official": { "type": "boolean" },
    "ui": {
      "type": "object",
      "required": ["entry"],
      "properties": { "entry": { "type": "string", "minLength": 1 } }
    },
    "backend": {
      "type": "object",
      "properties": {
        "command": { "type": "string" },
        "protocol": { "type": "string", "enum": ["json-rpc-2.0"] },
        "callTimeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 600 }
      }
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "files.read",
          "files.write",
          "network",
          "network.email",
          "clipboard.read",
          "clipboard.write",
          "notifications",
          "database"
        ]
      }
    },
    "aiTools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "description", "method", "inputSchema"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "method": { "type": "string", "minLength": 1 },
          "effect": { "type": "string", "enum": ["read", "write", "external"] },
          "inputSchema": { "type": "string", "minLength": 1 },
          "outputSchema": { "type": "string", "minLength": 1 },
          "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 600 }
        }
      }
    }
  }
}
