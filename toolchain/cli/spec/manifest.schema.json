{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://fengyu.dev/plugin/manifest.schema.json",
  "title": "FengYu plugin manifest",
  "description": "FengYu plugin manifest schema v2. The manifest is the single hand-written plugin contract; inputSchema/outputSchema are JSON-Schema objects (not escaped strings) declared once per RPC method on rpc.methods, and aiTools reference those methods by name. additionalProperties is false throughout so the contract is total and generator/host drift is caught at validation time.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "description", "version", "author", "icon", "category", "ui"],
  "definitions": {
    "jsonSchemaSubset": {
      "type": "object",
      "description": "The JSON-Schema subset the v2 generator supports: object, array, string, integer, number, boolean, plus enum/required/nullable. Anything outside this set must be rejected by the generator rather than silently coerced to a generic type.",
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["object", "array", "string", "integer", "number", "boolean"] },
        "description": { "type": "string" },
        "properties": { "type": "object", "additionalProperties": { "$ref": "#/definitions/jsonSchemaSubset" } },
        "items": { "$ref": "#/definitions/jsonSchemaSubset" },
        "required": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "enum": { "type": "array", "minItems": 1 },
        "nullable": { "type": "boolean" },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" }
      }
    },
    "inputSchema": {
      "type": "object",
      "description": "A method's input schema. RPC inputs are always objects, so the top-level type is pinned to \"object\".",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "const": "object" },
        "description": { "type": "string" },
        "properties": { "type": "object", "additionalProperties": { "$ref": "#/definitions/jsonSchemaSubset" } },
        "required": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "additionalProperties": { "type": "boolean" }
      }
    },
    "outputSchema": {
      "type": "object",
      "description": "A method's output schema. Outputs are object envelopes, so the top-level type is pinned to \"object\".",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "const": "object" },
        "description": { "type": "string" },
        "properties": { "type": "object", "additionalProperties": { "$ref": "#/definitions/jsonSchemaSubset" } },
        "required": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "additionalProperties": { "type": "boolean" }
      }
    },
    "rpcMethod": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputSchema"],
      "properties": {
        "description": { "type": "string" },
        "inputSchema": { "$ref": "#/definitions/inputSchema" },
        "outputSchema": { "$ref": "#/definitions/outputSchema" },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 600 }
      }
    },
    "localeOverride": {
      "type": "object",
      "additionalProperties": false,
      "description": "Locale-specific overrides for the manifest's display strings. Every field is independently optional; the host falls back to the top-level (default, English) field whenever an override is absent.",
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "aiTools": {
          "type": "object",
          "description": "Per-tool display overrides keyed by tool `name` (stable across versions). Each entry may override `name` and/or `description`; these are frontend-only and never reach the LLM.",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "description": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  },
  "properties": {
    "schemaVersion": { "type": "integer", "const": 2 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+].+)?$" },
    "author": { "type": "string", "minLength": 1 },
    "icon": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "minLength": 1 },
    "homepage": { "type": "string" },
    "official": { "type": "boolean" },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry"],
      "properties": { "entry": { "type": "string", "minLength": 1 } }
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "description": "Declares an out-of-process worker. The worker is fixed to backend/worker.jar speaking JSON-RPC 2.0; command/protocol are no longer expressed in the manifest. callTimeoutSeconds is the default per-call timeout.",
      "properties": {
        "callTimeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 600 }
      }
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "files.read",
          "files.write",
          "network",
          "network.email",
          "clipboard.read",
          "clipboard.write",
          "notifications",
          "database"
        ]
      }
    },
    "rpc": {
      "type": "object",
      "additionalProperties": false,
      "required": ["methods"],
      "properties": {
        "methods": {
          "type": "object",
          "description": "The complete method table shared by the UI and AI. Every UI RPC and every aiTools.method must resolve to a key here. Method names are lowerCamelCase identifiers.",
          "patternProperties": {
            "^[a-zA-Z_][a-zA-Z0-9_]*$": { "$ref": "#/definitions/rpcMethod" }
          },
          "additionalProperties": false
        }
      }
    },
    "aiTools": {
      "type": "array",
      "description": "AI-facing tools. Each tool references an rpc.methods entry by `method`; input/output schemas are NOT duplicated here. `effect` is mandatory authorization metadata for AI-invokable capabilities.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "description", "method", "effect"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "method": { "type": "string", "minLength": 1 },
          "effect": { "type": "string", "enum": ["read", "write", "external"] },
          "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 600 }
        }
      }
    },
    "i18n": {
      "type": "object",
      "description": "Optional locale overrides for the manifest's display strings. Keys are short lowercased locale tags (e.g. \"en\", \"zh\"); the host resolves the request locale (Accept-Language) with language-family fallback (\"zh-CN\" -> \"zh\"), then falls back to the top-level default. RPC method schemas are never localized here.",
      "patternProperties": {
        "^[a-z]{2,3}(-[A-Za-z0-9]+)*$": { "$ref": "#/definitions/localeOverride" }
      },
      "additionalProperties": false
    }
  }
}
