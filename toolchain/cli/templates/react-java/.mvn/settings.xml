<?xml version="1.0" encoding="UTF-8"?>
<!--
    Generated worker .mvn/settings.xml — resolves the FengYu Plugin Worker SDK
    from GitHub Packages. Credentials are injected from the environment only;
    this file never contains a token. The CLI maps GITHUB_TOKEN → the child-only
    FENGYU_GITHUB_TOKEN when the latter is absent, and defaults GITHUB_ACTOR.
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
  <servers>
    <server>
      <id>github</id>
      <username>${env.GITHUB_ACTOR}</username>
      <password>${env.FENGYU_GITHUB_TOKEN}</password>
    </server>
  </servers>
  <profiles>
    <profile>
      <id>fengyu-github</id>
      <repositories>
        <repository>
          <id>github</id>
          <url>https://maven.pkg.github.com/MuskStark/FengYu</url>
          <releases><enabled>true</enabled></releases>
          <snapshots><enabled>true</enabled></snapshots>
        </repository>
      </repositories>
    </profile>
  </profiles>
  <activeProfiles>
    <activeProfile>fengyu-github</activeProfile>
  </activeProfiles>
</settings>
