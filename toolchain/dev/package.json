{
  "name": "@infinia/plugin-dev",
  "version": "2.0.0",
  "description": "Vite plugin and simulator host used by `fengyu dev` for FengYu plugin development.",
  "license": "GPL-3.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
