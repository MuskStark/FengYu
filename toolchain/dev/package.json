{
  "name": "@infinia/plugin-dev",
  "version": "1.1.0",
  "description": "Vite plugin + simulator host for developing FengYu plugins in an IDE — replaces `fengyu plugin dev`.",
  "license": "GPL-3.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "engines": { "node": ">=22.0.0" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build && node --test test/*.test.mjs"
  },
  "keywords": ["fengyu", "infinia", "plugin", "vite", "devtools", "json-rpc"],
  "repository": {
    "type": "git",
    "url": "https://github.com/MuskStark/FengYu.git",
    "directory": "toolchain/dev"
  },
  "publishConfig": { "access": "public" },
  "peerDependencies": {
    "vite": "^5.0.0 || ^6.0.0 || ^7.0.0"
  },
  "devDependencies": {
    "@infinia/plugin-sdk": "file:../sdk-ts",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.2"
  }
}
