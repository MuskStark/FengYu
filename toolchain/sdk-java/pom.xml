<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
      FengYu Plugin Worker SDK — an INDEPENDENTLY versioned, self-contained POM.
      It does NOT inherit the FengYu parent reactor (which tracks ${revision}).
      Version 2.1.0 is the publishable contract external plugin developers
      resolve from GitHub Packages. Repository-internal consumers (OfficialPlugins,
      FengYu host) still build it through the root reactor <module>, so a local
      `./mvnw install` produces 2.1.0 in the local .m2 with no token required.

      2.1.0 adds the code-first contract annotations (fan.summer.fengyu.sdk.contract:
      @FengYuContract, @FengYuRpc, @FengYuAiTool, @FengYuField, @FengYuSensitive) that
      a Java plugin's contract interface declares; the devkit's annotation processor
      extracts them into the IR the CLI merges into manifest.json. No runtime API
      change — the annotations are inert at the worker's own runtime.

      2.0.0 is a MAJOR bump of the whole toolchain line (all six artifacts move
      at one version) driven by the BREAKING change in the sibling TypeScript
      SDK: @infinia/plugin-sdk no longer defaults the bridge target origin to
      '*' and refuses to bridge on hosts that do not append ?shellOrigin= to the
      plugin URL. This Java SDK itself ships no breaking API change in 2.0.0 —
      it moves in lockstep per the plugin-tooling release contract.

      1.1.0 adds the RpcTransport abstraction (StdioTransport + the contract a
      loopback-TCP transport in fengyu-plugin-devkit implements), letting the same
      JsonRpcWorker dispatch loop be driven from stdin/stdout (production) or a
      loopback socket (IDE debugging). run() / run(InputStream, OutputStream) are
      unchanged in behaviour; serve(RpcTransport) is the new shared entry point.

      1.2.0 adds a parent-death watchdog to the production run() entry point so a
      worker can never outlive its host: stdin EOF (primary) and a parent-process
      liveness poll (auxiliary) both converge on a guaranteed JVM exit, releasing
      file locks a worker's non-daemon threads (DB pools, executors) would
      otherwise hold. run(InputStream, OutputStream) is unchanged.

      1.3.0 adds worker-side i18n: WorkerLocale (per-request locale ThreadLocal
      bound by JsonRpcWorker.serve from the `locale` params key), PluginMessages
      (classpath message-bundle resolver for i18n/messages[_zh].properties), and
      keyed okKey/failKey/t helpers on PluginHandlerSupport so a worker renders
      localized summaries without changing the PluginHandler signature or the
      JSON-RPC envelope. Legacy workers without bundles keep prior English behaviour.
  -->
  <groupId>fan.summer.fengyu.sdk</groupId>
  <artifactId>fengyu-plugin-sdk</artifactId>
  <version>2.1.0</version>
  <name>FengYu Plugin Worker SDK</name>
  <description>Dependency-light JSON-RPC 2.0 worker runtime for FengYu plugin child processes.</description>

  <url>https://github.com/MuskStark/FengYu</url>
  <licenses>
    <license>
      <name>GNU General Public License v3.0</name>
      <url>https://www.gnu.org/licenses/gpl-3.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <gson.version>2.13.1</gson.version>
    <junit.version>5.10.2</junit.version>
    <!-- Aligned with the host reactor's slf4j.version (root pom.xml). The SDK is an
         independently-versioned POM and does not inherit the parent, so this is pinned
         here explicitly and bumped alongside the root property when upgrading. -->
    <slf4j.version>2.0.13</slf4j.version>
    <maven.compiler.plugin.version>3.13.0</maven.compiler.plugin.version>
    <maven.surefire.plugin.version>3.2.5</maven.surefire.plugin.version>
    <maven.source.plugin.version>3.3.1</maven.source.plugin.version>
    <maven.javadoc.plugin.version>3.11.2</maven.javadoc.plugin.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.google.code.gson</groupId>
      <artifactId>gson</artifactId>
      <version>${gson.version}</version>
    </dependency>
    <!-- Logging API. The SDK supplies its own SLF4J 2.x provider, which emits structured events
         to stderr and supports live host-controlled thresholds; stdout remains JSON-RPC-only. -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <version>${slf4j.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>${maven.compiler.plugin.version}</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${maven.surefire.plugin.version}</version>
      </plugin>
      <!-- Publish sources + javadoc alongside the artifact for external consumers. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
        <version>${maven.source.plugin.version}</version>
        <executions>
          <execution>
            <id>attach-sources</id>
            <goals><goal>jar-no-fork</goal></goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <version>${maven.javadoc.plugin.version}</version>
        <executions>
          <execution>
            <id>attach-javadocs</id>
            <goals><goal>jar</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <!-- Publish to GitHub Packages. Credentials come from the environment
       (GITHUB_ACTOR + FENGYU_GITHUB_TOKEN) via the consumer's .mvn/settings.xml;
       generated files never contain a token. -->
  <distributionManagement>
    <repository>
      <id>github</id>
      <name>GitHub Packages</name>
      <url>https://maven.pkg.github.com/MuskStark/FengYu</url>
    </repository>
  </distributionManagement>
</project>
