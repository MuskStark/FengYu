<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
      FengYu Plugin DevKit — an INDEPENDENTLY versioned, self-contained POM, sibling to
      fengyu-plugin-sdk. It does NOT inherit the FengYu parent reactor (which tracks ${revision});
      it lives in the reactor only so a local `./mvnw install` places it in .m2 next to the SDK.

      Purpose: a loopback-TCP JSON-RPC 2.0 server a plugin worker can run from its IDE so the
      author sets breakpoints in their handlers WITHOUT remote JDWP attach. Since 2.1.0 it also
      carries the code-first contract annotation processor (FengYuContractProcessor): bound to a
      plugin's `generate-resources` phase with `proc:only`, it extracts the @FengYuContract
      interface into the build-output IR the CLI merges into manifest.json. It is declared as a
      <scope>test</scope> dependency by scaffolded workers and the development main
      (PluginDevMain) lives under src/test/java, so the devkit NEVER ships inside a shaded
      production worker JAR.

      Version 2.1.0 is the publishable contract published to GitHub Packages alongside the SDK;
      it is kept in lockstep with fengyu-plugin-sdk by the plugin-tooling-release skill. 2.0.0
      predates the contract processor — do not build code-first plugins against it.
  -->
  <groupId>fan.summer.fengyu.sdk</groupId>
  <artifactId>fengyu-plugin-devkit</artifactId>
  <version>2.1.0</version>
  <name>FengYu Plugin DevKit</name>
  <description>Loopback-TCP JSON-RPC dev server plus the code-first contract annotation processor for FengYu plugin workers.</description>

  <url>https://github.com/MuskStark/FengYu</url>
  <licenses>
    <license>
      <name>GNU General Public License v3.0</name>
      <url>https://www.gnu.org/licenses/gpl-3.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <fengyu.plugin.sdk.version>2.1.0</fengyu.plugin.sdk.version>
    <junit.version>5.10.2</junit.version>
    <maven.compiler.plugin.version>3.13.0</maven.compiler.plugin.version>
    <maven.surefire.plugin.version>3.2.5</maven.surefire.plugin.version>
    <maven.source.plugin.version>3.3.1</maven.source.plugin.version>
    <maven.javadoc.plugin.version>3.11.2</maven.javadoc.plugin.version>
  </properties>

  <dependencies>
    <!-- Same worker runtime the production worker uses; the dev server drives its serve() loop. -->
    <dependency>
      <groupId>fan.summer.fengyu.sdk</groupId>
      <artifactId>fengyu-plugin-sdk</artifactId>
      <version>${fengyu.plugin.sdk.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>${maven.compiler.plugin.version}</version>
        <!-- The processor's own service descriptor lands in target/classes during
             process-resources, before the class it names exists; javac's default
             annotation-processor discovery then fails the module's own clean compile
             ("Provider ... not found"). Compiling the devkit with processing disabled
             is the standard self-hosting-processor pattern — consumers still discover
             FengYuContractProcessor through annotationProcessorPaths. -->
        <configuration>
          <proc>none</proc>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${maven.surefire.plugin.version}</version>
      </plugin>
      <!-- Publish sources + javadoc alongside the artifact for external consumers. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
        <version>${maven.source.plugin.version}</version>
        <executions>
          <execution>
            <id>attach-sources</id>
            <goals><goal>jar-no-fork</goal></goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <version>${maven.javadoc.plugin.version}</version>
        <executions>
          <execution>
            <id>attach-javadocs</id>
            <goals><goal>jar</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <!-- Publish to GitHub Packages, same repository as the SDK. Credentials come from the
       environment (GITHUB_ACTOR + FENGYU_GITHUB_TOKEN) via the consumer's .mvn/settings.xml;
       generated files never contain a token. -->
  <distributionManagement>
    <repository>
      <id>github</id>
      <name>GitHub Packages</name>
      <url>https://maven.pkg.github.com/MuskStark/FengYu</url>
    </repository>
  </distributionManagement>
</project>
