{
  "name": "@infinia/plugin-ui",
  "version": "2.1.0",
  "description": "Infinia React UI template kit for FengYu plugins — warm-white + gold design language on official Aceternity components.",
  "license": "GPL-3.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/plugin-ui.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json --declaration --emitDeclarationOnly --outDir dist && node --test test/build-output.test.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev:e2e": "vite --config vite.e2e.config.ts",
    "test:visual": "playwright test",
    "test:host": "playwright test --config playwright.host.config.ts",
    "prepack": "yarn run typecheck && yarn test && yarn run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MuskStark/FengYu.git",
    "directory": "toolchain/ui"
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "brace-expansion": "5.0.9"
  },
  "dependencies": {
    "@radix-ui/react-tabs": "^1.1.13",
    "@tabler/icons-react": "^3.48.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.545.0",
    "motion": "^12.23.12",
    "react-dropzone": "^14.3.8",
    "tailwind-merge": "^3.3.1"
  },
  "peerDependencies": {
    "@infinia/plugin-sdk": "^2.1.0",
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@infinia/plugin-sdk": "link:../sdk-ts",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "^4.1.13",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^26.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  },
  "packageManager": "yarn@4.18.0+sha512.fcb8716fe7cd0eece141ffc18b92193a9df9204c1ba83189c288835223fc0bbe64af473bab0d5e9927a7daeb5caf2bb07eb2787cc9338ca040ea125f2a1f2f7e"
}
