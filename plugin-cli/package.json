{
  "name": "@infinia/plugin-cli",
  "version": "1.1.0",
  "type": "module",
  "description": "Scaffold and build FengYu plugins. Development happens in your IDE via @infinia/plugin-dev.",
  "bin": { "fengyu": "bin/fengyu.mjs" },
  "files": ["bin", "src", "spec", "scripts", "templates", "README.md"],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "sync-spec": "node scripts/sync-spec.mjs",
    "check-spec": "node scripts/sync-spec.mjs --check",
    "verify-version": "node scripts/resolve-tooling-version.mjs --ref plugin-tooling-v1.1.0",
    "prepack": "npm run check-spec && npm test"
  },
  "engines": { "node": ">=24.18.0" },
  "license": "GPL-3.0",
  "repository": { "type": "git", "url": "git+https://github.com/MuskStark/FengYu.git", "directory": "plugin-cli" },
  "publishConfig": { "access": "public" },
  "dependencies": {
    "ajv": "^8.17.1",
    "yauzl": "^3.2.0"
  }
}
