{
  "schemaVersion": 2,
  "id": "dev.fengyu.pysmoke",
  "name": "Smoke Fixture (Python)",
  "description": "Python-runtime e2e smoke fixture: pins the toolchain's python packaging (worker.py + its runtime-imported contract.py + vendored SDK ship together, bytecode caches never ship) and the host's python worker spawn. Not distributed anywhere.",
  "version": "1.0.0",
  "engines": {
    "fengyu": ">=4.0.0-rc.2 <5.0.0"
  },
  "author": "FengYu",
  "icon": "flask-outline",
  "category": "developer-tools",
  "ui": {
    "entry": "ui/index.html"
  },
  "backend": {
    "runtime": "python",
    "protocolVersion": 4,
    "callTimeoutSeconds": 60
  },
  "permissions": [],
  "rpc": {
    "methods": {
      "hello": {
        "description": "Greets the given name back.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            }
          },
          "required": [
            "name"
          ]
        }
      }
    }
  }
}
