{
  "name": "fengyu-desktop",
  "private": true,
  "version": "4.1.0-beta.2",
  "description": "FengYu/Infinia desktop shell (Electron)",
  "author": "FengYu",
  "homepage": "https://github.com/MuskStark/FengYu",
  "main": "dist/main.js",
  "scripts": {
    "build:ts": "tsc -p tsconfig.json",
    "dev": "yarn build:ts && electron .",
    "build": "yarn build:ts && electron-builder",
    "build:win": "yarn build:ts && electron-builder --win",
    "build:mac": "yarn build:ts && electron-builder --mac",
    "build:linux": "yarn build:ts && electron-builder --linux",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test -c test/e2e/playwright.config.ts",
    "verify:frontend-dist": "node scripts/verify-frontend-dist.mjs frontend-dist/index.html"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "electron": "43.8.2",
    "electron-builder": "^26.16.0",
    "playwright": "^1.63.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "electron-log": "^5.2.0",
    "electron-updater": "^6.3.9",
    "tree-kill": "^1.2.2"
  },
  "resolutions": {
    "js-yaml": "4.3.2",
    "@xmldom/xmldom": "0.9.12",
    "http-cache-semantics": "4.3.0",
    "vite": "8.2.4",
    "undici@^8.4.1": "8.10.2",
    "undici@^7.24.4": "7.29.1",
    "undici@^6.25.0": "6.28.1",
    "fast-uri": "3.1.8",
    "brace-expansion@^1.1.7": "1.1.21",
    "brace-expansion@^2.0.1": "2.1.7",
    "brace-expansion@^2.0.2": "2.1.7",
    "brace-expansion@^5.0.8": "5.0.12",
    "source-map-js": "1.2.2"
  },
  "packageManager": "yarn@4.18.0+sha512.fcb8716fe7cd0eece141ffc18b92193a9df9204c1ba83189c288835223fc0bbe64af473bab0d5e9927a7daeb5caf2bb07eb2787cc9338ca040ea125f2a1f2f7e"
}
