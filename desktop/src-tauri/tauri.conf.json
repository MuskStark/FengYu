{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Infinia",
  "version": "4.0.0",
  "identifier": "fan.summer.fengyu",
  "build": {
    "beforeDevCommand": "cd ../frontend && npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "cd .. && node plugin-cli/bin/fengyu.mjs plugin build OfficialPlugins/plugin-markdown && node plugin-cli/bin/fengyu.mjs plugin build OfficialPlugins/plugin-excel && cd frontend && npm run build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ],
    "resources": {
      "../../OfficialPlugins/target/packages/fan.summer.markdown-4.0.0.fyp": "plugins/fan.summer.markdown-4.0.0.fyp",
      "../../OfficialPlugins/target/packages/fan.summer.excel-4.0.0.fyp": "plugins/fan.summer.excel-4.0.0.fyp"
    },
    "externalBin": []
  }
}
