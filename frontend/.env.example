# Token sent as the X-FengYu-Token header on every request except /api/health.
# In dev with auth disabled this can be left empty.
#
# WARNING: Vite bakes this value into the public JS bundle at build time — anyone who can
# load the page can read it. This is acceptable only for loopback/dev use. For a real web
# deployment either disable backend token auth (rely on a reverse proxy for access control)
# or proxy authentication server-side; never ship a production token through this variable.
VITE_FENGYU_TOKEN=
