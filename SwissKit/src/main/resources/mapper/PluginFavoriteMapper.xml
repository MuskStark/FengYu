<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="fan.summer.database.mapper.PluginFavoriteMapper">

    <select id="selectAll" resultType="fan.summer.database.entity.PluginFavoriteEntity">
        SELECT id, plugin_id AS pluginId, created_at AS createdAt
        FROM plugin_favorites
        ORDER BY created_at ASC
    </select>

    <select id="selectByPluginId" resultType="fan.summer.database.entity.PluginFavoriteEntity">
        SELECT id, plugin_id AS pluginId, created_at AS createdAt
        FROM plugin_favorites
        WHERE plugin_id = #{pluginId}
    </select>

    <insert id="insert" parameterType="fan.summer.database.entity.PluginFavoriteEntity">
        INSERT INTO plugin_favorites (plugin_id) VALUES (#{pluginId})
    </insert>

    <delete id="deleteByPluginId">
        DELETE FROM plugin_favorites WHERE plugin_id = #{pluginId}
    </delete>

    <select id="count" resultType="int">
        SELECT COUNT(*) FROM plugin_favorites
    </select>

</mapper>
