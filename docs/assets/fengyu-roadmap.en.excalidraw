   "textAlign": "left",
   "verticalAlign": "top",
   "lineHeight": 1.25,
   "autoResize": true,
   "text": "3.x → 4.0 was a full architectural rewrite: JavaFX monolith → headless web service + SPA + Electron shell; all built-in tools were split into sandboxed .fyp plugins.",
   "originalText": "3.x → 4.0 was a full architectural rewrite: JavaFX monolith → headless web service + SPA + Electron shell; all built-in tools were split into sandboxed .fyp plugins.",
   "containerId": null,
   "rawText": "3.x → 4.0 was a full architectural rewrite: JavaFX monolith → headless web service + SPA + Electron shell; all built-in tools were split into sandboxed .fyp plugins."
  },
